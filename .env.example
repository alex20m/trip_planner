# Supabase – set via the Vercel Supabase integration (Vercel -> Integrations), not by hand.
# Locally, run `vercel link` then `vercel env pull .env.local` to fetch these instead of filling them in here.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # used ONLY server-side (decline without login)

# Resend (https://resend.com -> API Keys) – added by hand in Vercel, scoped per environment:
# Production: verified domain sender. Development/Preview: onboarding@resend.dev sandbox sender
# (only delivers to your own account email, so local testing can't email real invitees).
RESEND_API_KEY=re_...
RESEND_FROM="PlanPal <onboarding@resend.dev>"

# App URL (Vercel domain in prod, http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=http://localhost:3000
